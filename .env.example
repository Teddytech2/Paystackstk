# Local development only. On Vercel, add these in Project Settings > Environment Variables.
# Never commit .env or expose secret keys to browser JavaScript.

NODE_ENV=production
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/teddytech?retryWrites=true&w=majority
MONGODB_SESSION_COLLECTION=sessions

# Paystack: use test keys until the complete flow is verified.
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me
DEFAULT_CURRENCY=KES
# Optional: use your deployed domain + /payment-result.html if you want to set a fixed callback.
PAYSTACK_CALLBACK_URL=

# Telegram donation notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_RETRY_MAX_ATTEMPTS=8

# Public company information
PUBLIC_COMPANY_NAME=Teddy Tech Inc
PUBLIC_WEBSITE_TITLE=Teddy Tech Inc | Support Our Servers
PUBLIC_TAGLINE=Keep Our Servers Running. Power the Future.
PUBLIC_SECONDARY_TAGLINE=Your Support Keeps Our Technology Alive.
PUBLIC_COMPANY_DESCRIPTION=Voluntary contributions help maintain servers, hosting, domains, and technology projects.
PUBLIC_CONTACT_EMAIL=
PUBLIC_WEBSITE_URL=
PUBLIC_TELEGRAM_URL=
PUBLIC_WHATSAPP_URL=
PUBLIC_GITHUB_URL=
